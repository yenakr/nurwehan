// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String            @id @default(cuid())
  studentId           String            @unique // 학번
  name                String
  grade               Int?              // 학년
  email               String?           @unique
  phone               String?
  password            String
  role                Role              @default(STUDENT)
  approvalStatus      ApprovalStatus    @default(PENDING)
  rejectedReason      String?
  admissionYear       Int?              // 입학연도
  currentSemester     Int?              // 현재 학기 (1 또는 2)
  targetCareer        String?           // 관심 진로
  targetHospital      String?           // 목표 병원
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  
  applications        Application[]     @relation("RepresentedApplications")
  participations      ApplicationParticipant[]
  restrictions        Restriction[]     @relation("UserRestrictions")
  createdRestrictions Restriction[]  @relation("AdminCreatedRestrictions")
  notices             Notice[]
  warnings            CleanupWarning[]
  personalEvents      PersonalCalendarEvent[]
  roadmapProgresses   UserRoadmapProgress[]
  healthRecords       StudentHealthRecord[]
  healthReadinesses   StudentHealthReadiness[]
}

model Semester {
  id        String   @id @default(cuid())
  name      String   // 예: 2026학년도 1학기
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  slots     OpenLabSlot[]
  gradeRules OpenLabGradeRule[]
}

model OpenLabGradeRule {
  id          String   @id @default(cuid())
  semesterId  String
  semester    Semester @relation(fields: [semesterId], references: [id])
  grade       Int
  dayOfWeek   Int      // 0-6 (Sunday-Saturday)
  startTime   String   // HH:mm
  endTime     String   // HH:mm
  room        String
  maxCapacity Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OpenLabSlot {
  id           String        @id @default(cuid())
  semesterId   String
  semester     Semester      @relation(fields: [semesterId], references: [id])
  allowedGrade Int
  date         DateTime
  startTime    String        // HH:mm
  endTime      String        // HH:mm
  room         String
  maxCapacity  Int
  status       SlotStatus    @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  applications Application[]
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  supplies    SkillSupply[]
  applications ApplicationSkill[]
}

model SkillSupply {
  id         String   @id @default(cuid())
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id])
  supplyName String
  quantity   Float
  unit       String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Application {
  id                   String            @id @default(cuid())
  slotId               String
  slot                 OpenLabSlot       @relation(fields: [slotId], references: [id])
  representativeUserId String?
  representativeUser   User?             @relation("RepresentedApplications", fields: [representativeUserId], references: [id])
  status               ApplicationStatus @default(PENDING)
  selectedGrade        Int?              // 신청 시 선택한 학년 구분
  subject              String?           // 실습과목
  professor            String?           // 담당교수
  purpose              String?           // 실습목적
  guestName            String?           // 비회원 신청자 이름
  guestStudentId       String?           // 비회원 신청자 학번
  guestPhone           String?           // 비회원 신청자 연락처
  guestGrade           Int?              // 비회원 신청자 학년
  additionalRequest    String?
  rejectedReason       String?
  submittedAt          DateTime          @default(now())
  approvedAt           DateTime?
  approvedById         String?
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  
  participants         ApplicationParticipant[]
  skills               ApplicationSkill[]
  confirmedNotice      Boolean           @default(false)
  otherSkillName       String?
  usageLogs            UsageLog[]
  restrictions         Restriction[]
  cleanupWarnings      CleanupWarning[]
}

model ApplicationParticipant {
  id               String           @id @default(cuid())
  applicationId    String
  application      Application      @relation(fields: [applicationId], references: [id])
  userId           String?          // nullable
  user             User?            @relation(fields: [userId], references: [id])
  studentId        String           // Not null
  name             String           // Not null
  attendanceStatus AttendanceStatus @default(PENDING)
  cleanupBad       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ApplicationSkill {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  skillId       String
  skill         Skill       @relation(fields: [skillId], references: [id])
  createdAt     DateTime    @default(now())
}

model UsageLog {
  id                 String      @id @default(cuid())
  applicationId      String
  application        Application @relation(fields: [applicationId], references: [id])
  submittedBy        String
  practiceContent    String
  difficulty         String
  nextPracticeGoal   String
  actualUsedSupplies String?
  cleanupChecked     Boolean     @default(false)
  wasteChecked       Boolean     @default(false)
  submittedAt        DateTime    @default(now())
  createdAt          DateTime    @default(now())
}

model Restriction {
  id                  String      @id @default(cuid())
  userId              String?     // nullable
  user                User?       @relation("UserRestrictions", fields: [userId], references: [id])
  studentId           String      // Not null
  studentName         String      // Not null
  reason              String
  sourceApplicationId String?
  sourceApplication   Application? @relation(fields: [sourceApplicationId], references: [id])
  startDate           DateTime
  endDate             DateTime
  isActive            Boolean     @default(true)
  createdById         String
  admin               User        @relation("AdminCreatedRestrictions", fields: [createdById], references: [id])
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model CleanupWarning {
  id                String      @id @default(cuid())
  userId            String?     // nullable
  user              User?       @relation(fields: [userId], references: [id])
  studentId         String      // Not null
  studentName       String      // Not null
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id])
  reason            String
  warningCountAfter Int
  createdById       String
  createdAt         DateTime    @default(now())
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  content     String
  targetGrade Int?     // null 이면 전체
  isPinned    Boolean  @default(false)
  createdById String
  user        User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------
// NUR위한 Roadmap / Calendar / Clinical / Career Models
// ----------------------------------------------------

model Course {
  id           String   @id @default(cuid())
  courseName   String
  courseCode   String?
  grade        Int      // 1, 2, 3, 4
  semester     Int      // 1, 2
  academicYear Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       CalendarEvent[]
}

model CalendarEvent {
  id                   String            @id @default(cuid())
  title                String
  description          String?
  startDateTime        DateTime
  endDateTime          DateTime?
  allDay               Boolean           @default(true)
  category             EventCategory     @default(ACADEMIC)
  academicYear         Int
  semester             Int?
  applicableGrades     Int[]
  isCommon             Boolean           @default(false)
  courseId             String?
  course               Course?           @relation(fields: [courseId], references: [id])
  priority             Int               @default(0)
  relatedRoadmapItemId String?
  relatedInternalUrl   String?
  externalUrl          String?
  status               PublicationStatus @default(PUBLISHED)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  roadmapItems         RoadmapItem[]
}

model PersonalCalendarEvent {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startDateTime DateTime
  endDateTime   DateTime?
  allDay        Boolean       @default(true)
  category      EventCategory @default(PERSONAL)
  isReminder    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model RoadmapItem {
  id                   String            @id @default(cuid())
  title                String
  description          String?
  category             String            // 학업, 실습, 어학, 취업, 비교과 등
  recommendedGrade     Int               // 1, 2, 3, 4
  recommendedSemester  Int?              // 1, 2
  recommendedStartDate DateTime?
  deadline             DateTime?
  priority             Int               @default(0)
  isRequired           Boolean           @default(true)
  relatedEventId       String?
  relatedEvent         CalendarEvent?    @relation(fields: [relatedEventId], references: [id])
  relatedInternalUrl   String?
  externalUrl          String?
  checklistItems       String[]          // sub-task titles
  status               PublicationStatus @default(PUBLISHED)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  userProgresses       UserRoadmapProgress[]
}

model UserRoadmapProgress {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItemId String
  roadmapItem   RoadmapItem @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)
  status        String      // NOT_STARTED, IN_PROGRESS, COMPLETED, ATTENTION_REQUIRED, PREPARING
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, roadmapItemId])
}

model HealthRequirement {
  id                  String            @id @default(cuid())
  name                String            // 예: A형 간염, 결핵검사 등
  category            String            // VACCINATION, LAB_TEST, DOCUMENT
  applicableGrades    Int[]
  applicableSemesters Int[]
  description         String?
  studentDisplayText  String?
  isRequired          Boolean           @default(true)
  status              PublicationStatus @default(PUBLISHED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  rules               HealthRequirementRule[]
  records             StudentHealthRecord[]
  readinesses         StudentHealthReadiness[]
}

model HealthRequirementRule {
  id                      String            @id @default(cuid())
  requirementId           String
  requirement             HealthRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  inputType               String            // DATE, DOSE, TEST_RESULT
  conditionType           String            // EQUAL, GREATER_THAN, POSITIVE, NEGATIVE
  conditionValue          String?
  resultStatus            ReadinessStatus
  nextActionPrompt        String?           // "2차 접종 필요", "추가 검사 권장" 등
  minIntervalDays         Int?
  recommendedIntervalDays Int?
  priority                Int               @default(0)
  active                  Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model StudentHealthRecord {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirementId   String
  requirement     HealthRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testDate        DateTime?
  resultType      String?           // POSITIVE, NEGATIVE, NUMERIC, TEXT
  resultValue     String?
  vaccinationDate DateTime?
  doseNumber      Int?
  documentStatus  String?           // HELD, SUBMITTED, NOT_HELD
  memo            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model StudentHealthReadiness {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   HealthRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  status        ReadinessStatus   @default(PREPARING)
  nextAction    String?
  nextDueDate   DateTime?
  calculatedAt  DateTime          @default(now())
  adminMemo     String?

  @@unique([userId, requirementId])
}

model CareerInfo {
  id            String            @id @default(cuid())
  title         String
  category      String            // LANGUAGE, HOSPITAL, INTERNSHIP, APTITUDE, NCLEX
  description   String?
  targetGrade   Int?
  externalUrl   String?
  status        PublicationStatus @default(PUBLISHED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model CampusActivity {
  id            String            @id @default(cuid())
  title         String
  category      String            // RESEARCH_LAB, UNDERGRAD_RESEARCH, SCHOLARSHIP, COMPETITION, VOLUNTEER, INTERNATIONAL
  description   String?
  targetGrade   Int?
  externalUrl   String?
  status        PublicationStatus @default(PUBLISHED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

enum Role {
  STUDENT
  ADMIN
  ASSISTANT
  SUPER_ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SlotStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  LATE_30
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum EventCategory {
  ACADEMIC
  EXAM
  CLINICAL
  HEALTH
  OPEN_LAB
  CAREER
  CAMPUS
  PERSONAL
  OFFICIAL
  STUDENT_COUNCIL
}

enum ReadinessStatus {
  SATISFIED
  IN_PROGRESS
  ATTENTION_REQUIRED
  INCOMPLETE
  PREPARING
}
